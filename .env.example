# Copy to .env (gitignored) or ~/.config/jevrail/.env and fill in.
# With the Claude Code plugin you can skip this: the plugin asks for the key
# when it's enabled and keeps it in your system's credential store.

# Typesafe API key for Jev (required for the Jev checks; local checks work without it)
TYPESAFE_API_KEY=

# Where jevrail keeps its answer cache, decision log and snapshots (optional)
# JEVRAIL_STATE_DIR=~/.cache/jevrail
